---
import Default from '@astrojs/starlight/components/Footer.astro';
---
<Default><slot /></Default>
<script>
  // Click or press Enter on a diagram to open it large in a dialog. The SVG itself moves into the
  // dialog and back, so there are no duplicate ids and the Mermaid styles keep applying.
  const dialog = document.createElement('dialog');
  dialog.className = 'diagram-dialog';
  dialog.setAttribute('aria-label', 'Enlarged diagram');
  dialog.innerHTML = '<button type="button" class="diagram-close" aria-label="Close">Close</button><div class="diagram-stage"></div>';
  document.body.append(dialog);
  const stage = dialog.querySelector<HTMLElement>('.diagram-stage')!;
  let open: { svg: SVGElement; home: HTMLElement } | null = null;

  const close = () => dialog.close();
  dialog.addEventListener('close', () => {
    if (!open) return;
    open.home.append(open.svg);
    open.home.querySelector<HTMLElement>('button')?.focus();
    open = null;
  });
  dialog.addEventListener('click', (e) => { if (e.target === dialog || (e.target as HTMLElement).closest('.diagram-close')) close(); });

  document.querySelectorAll<SVGElement>('.sl-markdown-content svg[id^="mermaid"]').forEach((svg) => {
    const home = document.createElement('div');
    home.className = 'diagram-home';
    svg.replaceWith(home);
    home.append(svg);
    const button = document.createElement('button');
    button.type = 'button';
    button.className = 'diagram-zoom';
    button.setAttribute('aria-label', 'Enlarge diagram');
    button.textContent = 'Enlarge';
    home.append(button);
    const show = () => { stage.replaceChildren(svg); open = { svg, home }; dialog.showModal(); };
    button.addEventListener('click', show);
    svg.addEventListener('click', show);
  });
</script>
<style is:global>
  .diagram-home { position: relative; }
  .diagram-home svg { cursor: zoom-in; }
  .diagram-zoom { position: absolute; top: 1rem; right: 1rem; font: 600 var(--sl-text-2xs)/1 var(--sl-font-mono); letter-spacing: 0.08em; text-transform: uppercase;
    color: var(--ab-navy); background: #fff; border: 1px solid #d5deea; border-radius: 8px; padding: 0.45rem 0.7rem; cursor: pointer; opacity: 0; transition: opacity 150ms; }
  .diagram-home:hover .diagram-zoom, .diagram-zoom:focus-visible { opacity: 1; }
  @media (hover: none) { .diagram-zoom { opacity: 1; } }
  .diagram-dialog { inset: 0; margin: auto; width: min(96vw, 110rem); height: min(92vh, 60rem); max-width: none; max-height: none; padding: 0; border: 0; border-radius: 16px; background: #f6f9fc; box-shadow: 0 24px 64px rgb(11 31 58 / 0.4); }
  .diagram-dialog::backdrop { background: rgb(5 12 24 / 0.7); }
  .diagram-stage { height: 100%; overflow: auto; display: grid; place-items: center; padding: 3.5rem 2rem 2rem; }
  .diagram-stage svg { width: 100%; max-width: none; height: auto; max-height: 100%; margin: 0; padding: 0; border: 0; background: none; cursor: default; }
  .diagram-close { position: absolute; top: 1rem; right: 1rem; z-index: 1; font: 600 var(--sl-text-2xs)/1 var(--sl-font-mono); letter-spacing: 0.08em; text-transform: uppercase; color: #fff; background: var(--ab-indigo); border: 0; border-radius: 999px; padding: 0.6rem 1rem; cursor: pointer; }
  .diagram-close:hover { background: var(--ab-indigo-deep); }
  @media (prefers-reduced-motion: reduce) { .diagram-zoom { transition: none; } }
</style>
