---
import Mark from './Mark.astro';
const { siteTitleHref } = Astro.locals.starlightRoute;
---
<a href={siteTitleHref} class="wordmark" translate="no">
  <Mark />
  <span><b>All</b> Boundaries</span>
</a>
<style>
  .wordmark { display: inline-flex; align-items: center; gap: 0.6rem; color: var(--sl-color-white); text-decoration: none; font-size: 1.125rem; letter-spacing: -0.02em; white-space: nowrap; font-weight: 500; }
  .wordmark b { font-weight: 800; }
</style>
