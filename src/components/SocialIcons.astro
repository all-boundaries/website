---
const links = [
  { href: '/journeys/build-one-service-testably/', label: 'Journeys' },
  { href: '/patterns/inside-a-service/domain/', label: 'Patterns' },
  { href: '/reference/glossary/', label: 'Reference' },
  { href: '/start/using-with-ai/', label: 'For AI' },
];
---
<nav class="top-links" aria-label="Sections">
  {links.map((l) => <a href={l.href}>{l.label}</a>)}
</nav>
<style>
  .top-links { display: flex; gap: 1.25rem; }
  .top-links a { font: 500 var(--sl-text-xs)/1 var(--sl-font-mono); letter-spacing: 0.02em; color: var(--sl-color-gray-3); text-decoration: none; padding: 0.5rem 0.125rem; }
  .top-links a:hover { color: var(--sl-color-white); }
  @media (max-width: 49.99rem) { .top-links { display: none; } }
</style>
