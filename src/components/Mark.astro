---
// A boundary crossed: an outlined rounded square with a filled circle straddling its edge.
const { size = 28 } = Astro.props;
---
<svg width={size} height={size} viewBox="0 0 28 28" aria-hidden="true" focusable="false">
  <rect x="2" y="3" width="17" height="17" rx="4" fill="none" stroke="currentColor" stroke-width="2.5" />
  <circle cx="18.5" cy="18.5" r="7" fill="var(--ab-signal)" />
</svg>
